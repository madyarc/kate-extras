# Maintainer: Madhesh <https://github.com/madyarc>
#
# Builds the checkout this PKGBUILD sits in (no second clone):
#   git clone https://github.com/madyarc/texmdpreview.git
#   cd texmdpreview/arch && makepkg -si
# Update later with: git pull && makepkg -si

pkgname=texmdpreview
pkgver=0.1
pkgrel=1
pkgdesc="Kate side panel: live Markdown preview with KaTeX math, LaTeX to PDF preview with SyncTeX"
arch=('x86_64')
url="https://github.com/madyarc/texmdpreview"
license=('GPL-3.0-or-later')
depends=('kate' 'ktexteditor' 'kparts' 'kcoreaddons' 'kconfig' 'qt6-base' 'qt6-webengine' 'okular')
makedepends=('cmake' 'extra-cmake-modules')
optdepends=('texlive-binextra: latexmk, needed to compile .tex files'
            'texlive-basic: pdflatex')

_katex=0.16.22
_mdit=14.1.0
source=("katex-$_katex.tgz::https://registry.npmjs.org/katex/-/katex-$_katex.tgz"
        "markdown-it-$_mdit.tgz::https://registry.npmjs.org/markdown-it/-/markdown-it-$_mdit.tgz")
noextract=("katex-$_katex.tgz" "markdown-it-$_mdit.tgz")
sha256sums=('SKIP'
            'SKIP')

_repo="$startdir/.."

build() {
  cmake -B build -S "$_repo" \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=None \
    -DKATEX_VERSION="$_katex" \
    -DMDIT_VERSION="$_mdit" \
    -DKATEX_TARBALL="$srcdir/katex-$_katex.tgz" \
    -DMDIT_TARBALL="$srcdir/markdown-it-$_mdit.tgz"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$_repo/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
